
class LinkedList {
  constructor() {
    this.first = null;
  }


  add(Profile) {
    let userProfile = Profile;
    if (this.first === null) {
      this.first = userProfile;
    } else {
      let current = this.first;
      while (current.next !== null) {
        current = current.next;
      }
      current.next = userProfile;
    }
  }




