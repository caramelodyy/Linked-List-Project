// LinkedList class
 constructor(passWord, name, age, hobby, areaOfResidence){
     this.first = null;
     this.current = first;
     this.passWord = passWord;
     this.name = name;
     this.age = age;
     this.hobby = hobby;
     this.areaOfResidence = areaOfResidence;
  }

  add(iD,name,age,hobby,placeOfResidence){
    let user = new Profile(iD,name,age,hobby,placeOfResidence);
    if(this.first == null){
      this.first = user;
    } else {
      let current = first;
      while(current !== null) current = current.next;
      current.next = user;
    }
  }
  show(iD,name,age,hobby,placeOfResidence){
    let current = this.first
    while( current !== null){
      current.display();//<- put something here for the position as well
      current = current.next;
    }
  }
}

