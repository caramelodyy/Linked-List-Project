class LinkedList {
  constructor() {
    this.first = null;
  }

  add(iD, passWord, name, age, hobby, placeOfResidence) {
    let user = new Profile(iD, passWord, name, age, hobby, placeOfResidence);
    if (this.first == null) {
      this.first = user;
    } else {
      let current = this.first;
      while (current !== null) {
        current = current.next;
      }
      current.next = user;
    }
  }

  show() {
    let current = this.first;
    let position = 0;
    while (current !== null) {
      current.display();

      current = current.next;
      position++;
    }
  }
}

