

class ProfileManager {
  constructor() {
    this.allProfiles = new LinkedList();
    this.nextId = 1;
    this.questionnaires = null;
  }

  async loadProfiles() {
    try {
      const lines = await loadStrings('./Data/profiles.txt');
      for (const line of lines) {
        if (!line || !line.trim()) {
          continue;
        }

        const values = line
          .split(',')
          .map((value) => value.trim().replace(/^"|"$/g, ''));

        if (values.length < 9) {
          continue;
        }

        const userProfile = new Profile(
          values[0],
          values[1],
          values[2],
          values[3],
          values[4],
          values[5],
          values[6],
          values[7],
          values[8]
        );

        this.allProfiles.add(userProfile);
      }
    } catch (error) {
      console.error('Failed to load profiles:', error);
    }
  }

  addNewProfile(iD, passWord, name, age, hobby1, hobby2, hobby3, placeOfResidence, likes) {
    const profileId = iD !== undefined && iD !== null ? iD : this.nextId++;
    const profile = new Profile(
      profileId,
      passWord,
      name,
      age,
      hobby1,
      hobby2,
      hobby3,
      placeOfResidence,
      likes
    );

    this.allProfiles.add(profile);
    return profile;
  }

  deleteProfile(iD) {
    return this.allProfiles.delete(iD);
  }

  //select a profile by using ID number
  editProfile() {
    this.questionnaires = new Questionnaires();
    return this.questionnaires;
  }

  Validate(profile) {
    if (!profile) {
      return false;
    }

    return Boolean(
      profile.iD &&
      profile.passWord &&
      profile.name &&
      profile.age &&
      profile.hobby1 &&
      profile.hobby2 &&
      profile.hobby3 &&
      profile.placeOfResidence &&
      profile.likes
    );
  }
}

  